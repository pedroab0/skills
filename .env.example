# Figma Access Token (Personal Access Token or OAuth Token)
# Generate at: Figma -> Settings -> Personal access tokens
FIGMA_ACCESS_TOKEN=figd_your_personal_access_token_here

# Alternative token variable name (optional)
# FIGMA_TOKEN=figd_your_personal_access_token_here

# Corporate Proxy / Self-Signed SSL Certificates (Optional)
# Set to 'true' if behind a corporate firewall with self-signed SSL certificates
# FIGMA_IGNORE_SSL=true
